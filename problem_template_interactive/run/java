#
# run/java de problema INTERATIVO (o conversor Polygon usa este no lugar do run/java do template
# quando o problem.xml tem interactor). Mesmo contrato do run/java normal:
# $1 main_class
# $2 input_file
# $3 timelimit (limit to run all the repetitions, by default only one repetition)
# $4 number_of_repetitions_to_run (interativo: roda 1 vez com TL/$4)
# $5 maximum allowed memory (in MBytes)
# $6 maximum allowed output size (in KBytes)
# stdout: o tout do interactor (o compare/<lang> le o veredito do interactor em run/verdict.X)
# exit: 0 ok (veredito no compare), 2/9 RE, 3 TLE, 7 MLE, 43 erro do pacote/launcher
# A logica comum (launcher, interactor, limites, veredito) esta em run/interactive.sh.
# Diferencas para o run/java normal: sem stdin0/stdout0 (o safeexec herda os pipes do launcher), o
# runit.sh fica em run/ (0700) e devolve o codigo do safeexec como codigo de saida (o launcher le).

umask 0022
id -u bocajail >/dev/null 2>/dev/null
if [ $? == 0 ]; then
	bocau=`id -u bocajail`
	bocag=`id -g bocajail`
	chown bocajail.nogroup .
else
	bocau=`id -u nobody`
	bocag=`id -g nobody`
	chown nobody.nogroup .
fi
if [ "$bocau" == "" -o "$bocag" == "" ]; then
	echo "error finding user to run script"
	exit 43
fi

sf=`which safeexec`
[ -x "$sf" ] || sf=/usr/bin/safeexec

if [ "$1" == "" -o "$2" == "" -o "$3" == "" ]; then
    echo "parameter problem"
    exit 43
fi
if [ -r run.exe ]; then
  rm -f run.jar
  cp run.exe run.jar
fi
if [ -r "$1" ]; then
  rm -f run.jar
  cp "$1" run.jar
fi
if [ ! -r run.jar ]; then
  echo "ERROR: file run.jar not found - possible error during compilation"
  exit 1
fi
name=`basename "$1"`
if [ "${name##*.}" == "class" ]; then
	name=`basename "$1" .class`
fi
if [ "${name##*.}" == "CLASS" ]; then
	name=`basename "$1" .CLASS`
fi
if [ ! -r "$2" ]; then
    echo "$2 not found (or is not in the current dir) or it's not readable"
    exit 45
fi
if [ ! -x "$sf" ]; then
    echo "$sf not found or it's not executable"
    exit 46
fi

zipf=$(find "$(dirname "$(dirname "$0")")" -maxdepth 1 -type f -name '*.zip' | head -n 1)
eval "$(unzip -p "$zipf" run/interactive.sh 2>/dev/null)"
type ia_setup >/dev/null 2>&1 || { echo "interactive: run/interactive.sh nao encontrado no pacote"; exit 43; }
ia_setup "$@"
let "maxms = $maxm / 10"

cdir=`pwd`
echo "Current directory is $cdir" >&2
echo $cdir | grep -q "/bocajail"
if [ $? == 0 ]; then
    cdir=`echo $cdir | sed "s/.*\/bocajail//"`
    jrundir=`echo $rundir | sed "s/.*\/bocajail//"`
    cat <<EOF2 > "$rundir/runit.sh"
#!/bin/bash
cd "$cdir"
[ -f /proc/cpuinfo ] || /bin/mount -t proc proc /proc
[ -d /sys/kernel ] || /bin/mount -t sysfs sysfs /sys
java=\`which java\`
[ -x "\$java" ] || java=/usr/bin/java
if [ ! -x "\$java" ]; then
    echo "\$java not found or it's not executable" >&2
    exit 47
fi
export CLASSPATH=.:./run.jar:$CLASSPATH
"$sf" -r1 -t$tl -T$wall -F256 -u256 -estderr0 -U$bocau -G$bocag -n0 -C. -f20000 -d20000000 -m20000000 -- "\$java" -Xmx${maxm}K -Xss${maxms}K -Xms${maxm}K "$name"
retval=\$?
if [ ! -d /bocajail ]; then
  /bin/umount /proc 2>/dev/null
  /bin/umount /sys 2>/dev/null
fi
# sem fechar stdin/stdout antes de sair: o interactor so pode ver EOF depois que o launcher
# souber como a solucao terminou
exit \$retval
EOF2
    chmod 700 "$rundir/runit.sh"
    ia_run -- chroot /bocajail "$jrundir/runit.sh"
else
    echo "CODE NOT BEING CHROOTED. DO NOT RUN THIS ON THE MAIN SERVER" >&2
    echo "CODE NOT BEING CHROOTED. DO NOT RUN THIS ON THE MAIN SERVER" >&2
    echo "CODE NOT BEING CHROOTED. DO NOT RUN THIS ON THE MAIN SERVER" >&2
	java=`which java`
	[ -x "$java" ] || java=/usr/bin/java
	if [ ! -x "$java" ]; then
		echo "$java not found or it's not executable"
		exit 47
	fi
	ia_run -- "$sf" -r1 -t$tl -T$wall -F256 -u256 -U$bocau -G$bocag -estderr0 -n0 -C. -d20000000 -m20000000 -- "$java" -cp run.jar -Xmx${maxm}K -Xss${maxms}K -Xms${maxm}K "$name"
fi
# sem -Z: como no run/java normal, codigo != 0 do programa (safeexec > 10) vira RE (9)
ia_finish
